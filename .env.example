# Copy to .env and fill in. Never commit .env.

# Frontend (safe in the browser, protected by row-level security)
VITE_USE_MOCK=true
# MapTiler map tiles. Create a key at maptiler.com and restrict it to your allowed origins.
VITE_MAPTILER_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only: scripts/ and supabase/functions/. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_KEY=
MBTA_API_KEY=
# Optional: most Google requests per day the place-photo endpoint may make (default 500)
PHOTO_DAILY_CAP=
