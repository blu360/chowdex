# Copy to .env and fill in. Never commit .env.

# Frontend (safe in the browser, protected by row-level security)
VITE_USE_MOCK=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only: scripts/ and supabase/functions/. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_KEY=
MBTA_API_KEY=
